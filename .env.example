DATABASE_URL=postgresql://username:password@host:5432/database
# Remote databases always verify TLS certificates. This project's Railway CA
# is bundled server-side. For another database or a rotated CA, set its public
# PEM certificate here (literal \n separators are supported).
DATABASE_SSL_CA=
# Optional certificate hostname when connecting through a TCP proxy; requires
# a dedicated CA. The bundled Railway certificate uses localhost automatically.
DATABASE_SSL_SERVERNAME=
BETTER_AUTH_SECRET=replace-with-at-least-48-random-characters
BETTER_AUTH_URL=https://www.example.com
# TCGHaven email is hosted by TransIP. Port 465 uses encrypted SMTP over TLS.
SMTP_HOST=smtp.transip.email
SMTP_PORT=465
SMTP_USER=mailbox@example.com
SMTP_PASS=replace-with-smtp-password
AUTH_EMAIL_FROM=Example Store <no-reply@example.com>

# Private inbox that receives paid-order alerts.
ORDER_NOTIFICATION_EMAIL=orders@example.com
MOLLIE_API_KEY=test_replace_with_mollie_api_key
PUBLIC_APP_URL=https://www.example.com
# Random server-only secret (32+ characters) for the order/email recovery job.
CRON_SECRET=
# Independent stable random key (48+ characters) for encrypted payment retries.
# Required for checkout. Do not reuse BETTER_AUTH_SECRET or rotate without
# first reconciling pending payment attempts.
ORDER_RECOVERY_ENCRYPTION_KEY=

# Owner-controlled shipping provider credentials
POSTNL_API_KEY=
POSTNL_CUSTOMER_NUMBER=
POSTNL_CUSTOMER_CODE=
POSTNL_COLLECTION_LOCATION=
POSTNL_MODE=sandbox
POSTNL_BARCODE_RANGE_START=
POSTNL_BARCODE_RANGE_END=

# Developer-managed production services
SENTRY_DSN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional Yu-Gi-Oh printing-image enrichment. Leave authorization false until
# the image rights holder grants written commercial rehosting permission.
YUGIPEDIA_CONTACT_EMAIL=developer@example.com
YUGIPEDIA_IMAGE_USE_AUTHORIZED=false

# Riftbound catalogue import. Create these in the Scrydex Account Hub and keep
# both values server-side; never expose them through PUBLIC_ variables.
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# Set only after the owner or responsible specialist confirms each item
BACKUPS_CONFIRMED=false
VAT_RULES_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
GOOGLE_MERCHANT_ID=

# Optional: card photo search in the navbar. A Google Cloud Vision API key
# restricted to the Cloud Vision API (and, ideally, your server's IP).
GOOGLE_VISION_API_KEY=
