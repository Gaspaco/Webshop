DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_little_tcg_haven
BETTER_AUTH_SECRET=replace-with-at-least-48-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# TCGHaven email is hosted by TransIP. Port 465 uses encrypted SMTP over TLS.
SMTP_HOST=smtp.transip.email
SMTP_PORT=465
SMTP_USER=info@tcghaven.com
SMTP_PASS=replace-with-the-info-mailbox-password
# Change this to no-reply@tcghaven.com only after that mailbox or alias exists in TransIP.
AUTH_EMAIL_FROM=TCGHaven <info@tcghaven.com>
MOLLIE_API_KEY=test_replace_me
PUBLIC_APP_URL=http://localhost:3000

# Owner-controlled shipping provider credentials
POSTNL_API_KEY=

# Developer-managed production services
SENTRY_DSN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Set only after the owner or responsible specialist confirms each item
BACKUPS_CONFIRMED=false
VAT_RULES_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
GOOGLE_MERCHANT_ID=
