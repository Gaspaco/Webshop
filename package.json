    "@solidjs/start": "1.3.2",
    "@tanstack/solid-query": "^5.101.2",
    "@tanstack/solid-table": "^8.21.3",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "nodemailer": "9.0.6",
