{
  "name": "my-little-tcg-haven",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "preinstall": "node scripts/verify-npm-registry.mjs",
    "dev": "vinxi dev",
    "build": "node --test src/lib/dependency-security.test.mjs && vinxi build",
    "start": "vinxi start",
    "preview": "vinxi preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "security:check": "node --test src/lib/dependency-security.test.mjs && node scripts/check-vendored-advisories.mjs && npm audit --audit-level=low && npm ls esbuild brace-expansion browserslist nanoid deepmerge serialize-javascript",
    "test:security": "TCG_SECURITY_INTEGRATION=1 bun run scripts/security-integration.ts",
    "security:patch-check": "node --test src/lib/dependency-security.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sync:yugioh": "bun scripts/sync-yugipedia.ts",
    "db:sync:yugioh-images": "bun scripts/sync-yugipedia-images.ts",
    "admin:create": "bun scripts/create-admin.ts",
    "admin:invite": "bun scripts/invite-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@mollie/api-client": "^4.6.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "1.3.2",
    "@tanstack/solid-query": "^5.101.2",
    "@tanstack/solid-table": "^8.21.3",
    "better-auth": "1.7.7",
    "braces": "file:./vendor/braces",
    "deepmerge": "file:./vendor/deepmerge",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "nodemailer": "10.1.7",
    "node-forge": "1.4.3",
    "pg": "8.22.0",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "sass": "^1.101.0",
    "sharp": "0.35.5",
    "solid-js": "1.9.17",
    "vinxi": "^0.5.7",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/bun": "1.4.3",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@better-auth/core": "1.7.7",
    "h3": "^1.15.11",
    "esbuild": "0.28.1",
    "brace-expansion": "5.0.12",
    "braces": "file:./vendor/braces",
    "deepmerge": "file:./vendor/deepmerge",
    "node-forge": "1.4.3",
    "seroval": "1.6.11",
    "source-map-js": "1.2.2",
    "browserslist": "4.28.7",
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "tar": "7.5.22",
    "follow-redirects": "1.16.2",
    "vite": "6.4.5",
    "serialize-javascript": "7.1.3",
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
